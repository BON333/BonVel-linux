#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 0 ]]; then
    echo "Uso: bonvel-live-set-password" >&2
    exit 2
fi

status="$(passwd --status bonvel)"
if [[ $status != "bonvel L "* ]]; then
    echo "A palavra-passe da conta live já está configurada."
    exit 0
fi

echo "Define uma palavra-passe para a sessão live do BonVel."
passwd bonvel
